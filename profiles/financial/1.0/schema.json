{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adl-spec.org/profiles/financial/1.0/schema.json",
  "title": "ADL Financial Profile",
  "description": "JSON Schema for ADL documents declaring the financial profile (urn:adl:profile:financial:1.0). Extends the base ADL schema via allOf composition. Designed to compose with the governance profile, so the top level is not sealed.",
  "$defs": {
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "description": "Vendor-namespaced extensions. Keys are reverse-domain identifiers."
    }
  },
  "allOf": [
    { "$ref": "https://adl-spec.org/0.3/schema.json" }
  ],
  "type": "object",
  "required": ["financial_data_handling", "data_classification"],
  "properties": {
    "profiles": {
      "type": "array",
      "contains": { "const": "urn:adl:profile:financial:1.0" }
    },
    "financial_data_handling": {
      "type": "object",
      "description": "Financial data handling configuration. REQUIRED when using this profile.",
      "properties": {
        "pci_scope": {
          "type": "object",
          "required": ["in_scope"],
          "properties": {
            "in_scope": { "type": "boolean" },
            "saq_type": { "type": "string" },
            "tokenization_required": { "type": "boolean" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "data_residency": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["jurisdiction"],
            "properties": {
              "jurisdiction": { "type": "string", "minLength": 1 },
              "regulation": { "type": "string" },
              "extensions": { "$ref": "#/$defs/extensions" }
            },
            "additionalProperties": false
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "transaction_controls": {
      "type": "object",
      "description": "Controls for agents that execute or influence financial transactions.",
      "properties": {
        "transaction_limits": {
          "type": "object",
          "properties": {
            "max_single_amount": { "type": "number", "minimum": 0 },
            "max_daily_volume": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "description": "ISO 4217 currency code" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "pre_execution_controls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "price_tolerance_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
            "throttle_per_second": { "type": "number", "minimum": 0 },
            "requires_approval_above": { "type": "number", "minimum": 0 },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "kill_switch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "trigger_conditions": { "type": "array", "items": { "type": "string" } },
            "notification_targets": { "type": "array", "items": { "type": "string" } },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "segregation_of_duties": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "restricted_actions": { "type": "array", "items": { "type": "string" } },
            "approval_role": { "type": "string" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "regulatory_scope": {
      "type": "object",
      "description": "Declaration of which financial regulations apply to this agent.",
      "required": ["applicable_regulations"],
      "properties": {
        "applicable_regulations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "PCI_DSS_V4", "SOX", "GLBA", "BASEL_III", "FINRA",
              "SEC_REG", "DORA", "MIFID_II", "BSA_AML", "EU_AMLD"
            ]
          }
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jurisdiction": { "type": "string" },
              "regulation": { "type": "string" },
              "extensions": { "$ref": "#/$defs/extensions" }
            },
            "additionalProperties": false
          }
        },
        "reporting_obligations": {
          "type": "object",
          "properties": {
            "authorities": { "type": "array", "items": { "type": "string" } },
            "frequency": {
              "type": "string",
              "enum": ["real_time", "daily", "monthly", "quarterly", "annual"]
            },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "record_retention": {
          "type": "object",
          "properties": {
            "min_retention_days": { "type": "number", "minimum": 0 },
            "tamper_proof": { "type": "boolean" },
            "format": { "type": "string" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "financial_risk_management": {
      "type": "object",
      "description": "Risk management controls for financial agents.",
      "properties": {
        "model_risk": {
          "type": "object",
          "properties": {
            "tier": { "type": "string", "enum": ["tier_1", "tier_2", "tier_3"] },
            "validated_by": { "type": "string" },
            "validated_at": { "type": "string", "format": "date-time" },
            "methodology": { "type": "string" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "aml_controls": {
          "type": "object",
          "properties": {
            "screening_required": { "type": "boolean" },
            "monitoring_level": { "type": "string", "enum": ["real_time", "daily", "periodic"] },
            "kyc_refresh_days": { "type": "number", "minimum": 0 },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "operational_risk": {
          "type": "object",
          "properties": {
            "category": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
            "assessed_by": { "type": "string" },
            "assessed_at": { "type": "string", "format": "date-time" },
            "capital_reserve": { "type": "boolean" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "data_classification": {
      "type": "object",
      "description": "Core data_classification, tightened: MUST carry a financial sub-object and include the financial category.",
      "required": ["categories", "financial"],
      "properties": {
        "categories": {
          "type": "array",
          "contains": { "const": "financial" }
        },
        "financial": {
          "type": "object",
          "required": ["data_types"],
          "properties": {
            "data_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "cardholder_data", "sensitive_auth_data", "nonpublic_personal_info",
                  "transaction_data", "market_data", "financial_reports", "material_nonpublic_info"
                ]
              }
            },
            "pci_applicable": { "type": "boolean" },
            "extensions": { "$ref": "#/$defs/extensions" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
